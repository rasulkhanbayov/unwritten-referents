# Copy to .env and fill in. .env is gitignored -- never commit it.
# Every Slurm job and scripts/*_hf.sh source this file.
#
# Hugging Face access token (https://huggingface.co/settings/tokens).
# Needed to download the GATED model weights (Gemma 2, Llama 3.1): accept each
# model's licence on its Hub page with the same account first, or downloads fail
# with GatedRepoError/401 even though the network works.
# Also used by scripts/upload_to_hf.sh / download_from_hf.sh (needs write scope to upload).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
